# ═══════════════════════════════════════════════════════════════════════════════
#  eMeet — Variables de entorno del monorepo
#  Copia este archivo como .env.local (frontend) o .env (microservicios)
#  y completa con tus valores reales.
#
#  ⚠️  NUNCA SUBAS ARCHIVOS .env* CON CREDENCIALES REALES AL REPOSITORIO.
#      Todos los archivos .env y .env.* están en .gitignore.
#      Solo los archivos .env.example pueden ser versionados.
# ═══════════════════════════════════════════════════════════════════════════════


# ─── SUPABASE — Compartido entre todos los microservicios backend ─────────────
#  Obtén estos valores en: https://supabase.com/dashboard → Settings → API
#
#  SUPABASE_URL: URL pública del proyecto Supabase.
#  SUPABASE_ANON_KEY: Clave anónima (segura para frontend con RLS activo).
#  SUPABASE_SERVICE_ROLE_KEY: Clave de servicio — bypasea RLS.
#    ⚠️  SOLO para backend (Express/Node). NUNCA en el frontend ni con NEXT_PUBLIC_.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ─── BASE DE DATOS — Prisma (packages/db) ─────────────────────────────────────
#  Obtén las URLs en: Supabase Dashboard → Settings → Database → Connection string
#
#  DATABASE_URL : Pooler de Supabase (puerto 6543) — para operaciones en runtime.
#  DIRECT_URL   : Conexión directa (puerto 5432) — para migraciones con Prisma.

DATABASE_URL=
DIRECT_URL=


# ─── FRONTEND Next.js (apps/app-web) — Variables públicas (NEXT_PUBLIC_) ───────
#  Las variables con prefijo NEXT_PUBLIC_ quedan embebidas en el bundle del cliente.
#  Solo incluir aquí lo que el navegador necesita saber.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

#  URLs de los microservicios (apuntadas desde el navegador al backend local o desplegado)
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_PROFILE_URL=http://localhost:3002
NEXT_PUBLIC_EVENTS_URL=http://localhost:3003
NEXT_PUBLIC_SAVED_URL=http://localhost:3004
NEXT_PUBLIC_CHAT_URL=http://localhost:3005
NEXT_PUBLIC_PLACES_URL=http://localhost:3006
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3007

#  Google Maps cargado por el SDK en el cliente. Restringir por dominio en GCP.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# ─── FRONTEND Next.js (apps/app-web) — Variables privadas (server-side) ────────
#  Sin prefijo NEXT_PUBLIC_: solo disponibles en API Routes y Server Components.
#  El navegador nunca recibe estos valores.

#  Ticketmaster Discovery API — https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

#  Service Role solo si hay lógica server-side en Next.js que requiera bypassear RLS.
#  Si no se usa desde Next.js directamente, dejar vacío.
SUPABASE_SERVICE_ROLE_KEY=


# ─── APIS EXTERNAS — Backend privado ──────────────────────────────────────────
#  Estas claves viven en sus respectivos microservicios, nunca en el frontend.

#  Google Maps usado en app-places para geocodificación server-side
GOOGLE_MAPS_API_KEY=


# ─── REDIS — packages/redis ───────────────────────────────────────────────────
#  Desarrollo local: redis://localhost:6379
#  Producción (Upstash, Railway, Redis Cloud): rediss://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379


# ─── MICROSERVICIOS — CORS ────────────────────────────────────────────────────
#  URL del frontend permitida. En producción reemplazar por el dominio real.
FRONTEND_ORIGIN=http://localhost:3000
#  Lista separada por comas para múltiples dominios (preview, producción, etc.)
# FRONTEND_ORIGINS=https://emeet.vercel.app,https://preview.emeet.vercel.app


# ─── PUERTOS por microservicio (referencia — valores por defecto) ─────────────
# app-auth    PORT=3001
# app-profile PORT=3002
# app-events  PORT=3003
# app-saved   PORT=3004
# app-chat    PORT=3005
# app-places  PORT=3006
# app-admin   PORT=3007
