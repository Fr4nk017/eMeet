# ─── packages/redis · Configuración de Redis ─────────────────────────────────
# Copia este archivo como .env y rellena con tus valores reales.
# NUNCA subas el archivo .env con credenciales reales al repositorio.

# ─── Redis ────────────────────────────────────────────────────────────────────
# Desarrollo local: redis://localhost:6379
# Producción (Upstash, Railway, Redis Cloud, etc.):
#   rediss://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379
