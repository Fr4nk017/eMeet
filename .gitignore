# Dependencies
node_modules/

# Build outputs
.next/
dist/
dist-ssr/
out/

# ─── Variables de entorno — NUNCA versionar archivos con credenciales reales ──
# Se ignoran .env y cualquier variante (.env.local, .env.development, etc.)
# La única excepción son los archivos .env.example, que SÍ se versionan
# porque solo contienen nombres de variables, sin valores reales.
.env
.env.*
!.env.example
# Ignorar también variantes con sufijo por si existen archivos como
# apps/app-auth/.env.local o packages/db/.env.development
**/.env
**/.env.*
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Turbo
.turbo

# TypeScript
*.tsbuildinfo

# Prisma — cache de engines (regenerar con `npm run db:generate`)
packages/db/node_modules/.prisma/
