# ─── app-places · Microservicio de Lugares ───────────────────────────────────
# Copia este archivo como .env y rellena con tus valores reales.
# NUNCA subas el archivo .env con credenciales reales al repositorio.

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3006

# ─── Google Maps (Backend privado — usar en server-side solamente) ────────────
# Obtén tu clave en: https://console.cloud.google.com/apis/credentials
# Activa: Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
# FRONTEND_ORIGINS=https://tu-dominio.vercel.app
