# ─── app-events · Microservicio de Eventos ───────────────────────────────────
# Copia este archivo como .env y rellena con tus valores reales.
# NUNCA subas el archivo .env con credenciales reales al repositorio.

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3003

# ─── Supabase (Backend privado — NUNCA exponer al frontend) ──────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
# FRONTEND_ORIGINS=https://tu-dominio.vercel.app
