# ─── app-auth · Microservicio de Autenticación ───────────────────────────────
# Copia este archivo como .env y rellena con tus valores reales.
# NUNCA subas el archivo .env con credenciales reales al repositorio.

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001

# ─── Supabase (Backend privado — NUNCA exponer al frontend) ──────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL del frontend Next.js. En producción, reemplazar por el dominio real.
FRONTEND_ORIGIN=http://localhost:3000
# Lista separada por comas para múltiples orígenes (opcional)
# FRONTEND_ORIGINS=https://tu-dominio.vercel.app,https://otro-dominio.com
