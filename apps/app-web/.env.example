# ─── app-web · Frontend Next.js ──────────────────────────────────────────────
# Copia este archivo como .env.local y rellena con tus valores reales.
# NUNCA subas .env.local ni .env.production al repositorio.
#
# REGLA DE ORO EN NEXT.JS:
#   Variables con NEXT_PUBLIC_ → expuestas al navegador (cliente).
#   Variables sin ese prefijo  → solo disponibles en el servidor (API Routes, Server Components).
#   ⚠️  NUNCA pongas SUPABASE_SERVICE_ROLE_KEY con prefijo NEXT_PUBLIC_.

# ─── Supabase (público — cliente/servidor) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase Service Role (SOLO servidor — API Routes, Server Actions) ───────
# Esta clave bypasea Row Level Security. No usar en client components.
SUPABASE_SERVICE_ROLE_KEY=

# ─── URLs de Microservicios (público — usadas desde el navegador) ─────────────
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_PROFILE_URL=http://localhost:3002
NEXT_PUBLIC_EVENTS_URL=http://localhost:3003
NEXT_PUBLIC_SAVED_URL=http://localhost:3004
NEXT_PUBLIC_CHAT_URL=http://localhost:3005
NEXT_PUBLIC_PLACES_URL=http://localhost:3006
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3007

# ─── Google Maps (público — cargado por el SDK de Google en el cliente) ───────
# Obtén tu clave en: https://console.cloud.google.com/apis/credentials
# Activa: Maps JavaScript API, Places API
# Restringe la clave por dominio en producción para evitar uso no autorizado.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── APIs externas (privadas — solo accedidas desde API Routes server-side) ───
# Ticketmaster: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=

# ─── Base de datos — Prisma (solo si se usa Prisma desde Next.js directamente) ─
# En este proyecto Prisma vive en packages/db. Si usas PrismaClient desde
# una API Route de Next.js, define DATABASE_URL aquí también.
DATABASE_URL=
